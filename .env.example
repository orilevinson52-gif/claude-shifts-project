# ==============================================================================
# Shift Scheduler - Environment Configuration
# ==============================================================================

# Option A: Single Database Connection URL (Recommended for Cloud / Render)
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>

# Option B: Individual Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=shift_scheduler

# SSL Settings for Cloud Database (TiDB Cloud / Aiven / AWS RDS)
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSL_VERIFY_CERT=true
# DB_SSL_DISABLED=false

# Application Settings
PORT=8080
AUTO_INIT_DB=true
# Secret that signs login sessions (required in production; any long random string)
# STORAGE_SECRET=

# Username of the account that sees the user-management tab (leave empty for none)
# ADMIN_USERNAME=
